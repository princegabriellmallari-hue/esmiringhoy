/* ==========================================================
   PERSONAL BUDGET TRACKER - style.css (DESIGN)  [REDESIGN]
   Dashboard look: white sidebar, light gray background,
   white bordered cards, thin progress bars, blue button.
   A rule looks like:  selector { property: value; }
   ========================================================== */


/* ---------- PART A | COLORS AND BASICS ----------
   PURPOSE: Color variables (change the theme in ONE place)
   and base text settings. Use a color with var(--blue). */
:root {
  --bg: #f3f5f7;
  --card: #ffffff;
  --border: #e5e7eb;
  --text: #1f2937;
  --muted: #6b7280;
  --blue: #2563eb;
  --blue-dark: #1d4ed8;
  --green: #16a34a;
  --red: #dc2626;
  --track: #e5e7eb;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Inter, "Segoe UI", system-ui, Arial, sans-serif;
  font-size: 14px;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
}

h2 { margin: 0 0 16px 0; font-size: 22px; font-weight: 700; padding-right: 150px; }
h3 { margin: 0 0 12px 0; font-size: 14px; font-weight: 600; }

.muted  { color: var(--muted); }
.red    { color: var(--red); }
.hidden { display: none; }   /* helper class: JS hides things with this */


/* ---------- PART B | LAYOUT AND SIDEBAR ----------
   PURPOSE: Sidebar on the left (sticky), content on the right.
   The active tab gets a soft gray background.
   The hamburger (☰) hides the tabs using a hidden checkbox. */
.app { display: flex; min-height: 100vh; }

.sidebar {
  width: 210px;
  flex-shrink: 0;
  background: #ffffff;
  border-right: 1px solid var(--border);
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.menu-check { display: none; }
.menu-check:checked ~ .side-nav { display: none; }

.brand { display: flex; align-items: center; gap: 8px; }
.logo {
  width: 22px; height: 22px;
  flex-shrink: 0;
  border-radius: 50%;
  background: #e5e7eb;
  border: 1px solid #d1d5db;
}
.brand-name { font-weight: 700; font-size: 14px; line-height: 1.25; }
.menu-btn { margin-left: auto; font-size: 18px; cursor: pointer; padding: 0 4px; user-select: none; }

.brand-sub { margin: 8px 0 16px 0; font-size: 12px; color: var(--muted); }

.side-nav { display: flex; flex-direction: column; gap: 2px; }
.side-nav .nav-btn {
  text-align: left;
  border: none;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-family: inherit;
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
}
.side-nav .nav-btn:hover  { background: #f3f4f6; }
.side-nav .nav-btn.active { background: #e8ebef; color: var(--text); font-weight: 600; }

.side-footer { margin: auto 0 0 0; padding-top: 16px; font-size: 11px; color: var(--muted); }

.content { flex: 1; padding: 20px 24px; min-width: 0; position: relative; }


/* ---------- PART C | PAGES (TAB SWITCHING) ----------
ASSIGN:
   PURPOSE: Every .page is hidden; only .page.active shows.
   JavaScript just moves the word "active". */
.page        { display: none; }
.page.active { display: block; }

/* Blue shortcut button, top right (same row as the page title) */
.btn-top {
  position: absolute;
  top: 20px;
  right: 24px;
  background: var(--blue);
  color: #fff;
  border: none;
  border-radius: 6px;
  padding: 8px 14px;
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
}
.btn-top:hover { background: var(--blue-dark); }
/* Hide the shortcut while already on the Add Expense page */
body:has(#expense-section.active) .btn-top { display: none; }


/* ---------- PART D | CARDS AND GRIDS ----------
ASSIGN:gab
   PURPOSE: White bordered boxes. .grid-2 = two cards side by side. */
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px 20px;
  margin-bottom: 16px;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  align-items: start;
}

/* Remove bottom margin when cards are placed inside .grid-2 so the grid gap controls spacing */
.grid-2 > .card {
  margin-bottom: 0;
}

/* ---------- PART E | FORMS AND BUTTONS ----------
ASSIGN: lio
   PURPOSE: Labels, text boxes, dropdowns, the blue button.
   .form-grid puts the Add Expense fields in two columns. */
label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 6px;
}

input[type="text"],
input[type="number"],
input[type="date"],
select {
  width: 100%;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 14px;
  font-family: inherit;
  color: var(--text);
  background: #ffffff;
  margin-bottom: 12px;
}

input:focus,
select:focus {
  outline: none;
  border-color: var(--blue);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0 16px;
}

.btn-primary,
form button[type="submit"] {
  background: var(--blue);
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 9px 16px;
  font-size: 13px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
}

.btn-primary:hover,
form button[type="submit"]:hover {
  background: var(--blue-dark);
}

/* Small gray "Update" button in the Wallets rows */
.btn-small {
  background: #f3f4f6;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px 10px;
  font-size: 12px;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
}

.btn-small:hover {
  background: #e5e7eb;
}


/* ---------- PART F | COLORED MESSAGES ----------
ASSIGN: mark
   PURPOSE: green = Safe/success, orange = WARNING (80%+),
   red = ALERT/error, blue = Note. :empty hides blank boxes. */
.msg {
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  margin-top: 12px;
  border: 1px solid transparent;
}

.msg:empty {
  display: none;
}

.msg.success,
.msg.safe {
  background: #f0fdf4;
  color: var(--green);
  border-color: #bbf7d0;
}

.msg.warning,
.msg.warn {
  background: #fffbeb;
  color: #d97706;
  border-color: #fde68a;
}

.msg.error,
.msg.danger {
  background: #fef2f2;
  color: var(--red);
  border-color: #fecaca;
}

.msg.note,
.msg.info {
  background: #eff6ff;
  color: var(--blue);
  border-color: #bfdbfe;
}



/* ---------- PART G | LISTS, WALLET ROWS, TABLE ----------
ASSIGN:jian
   PURPOSE: Daily breakdown / wallet summary lists, the account
   rows in Wallets, and the Expenses table (amounts in red). */
.summary-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.summary-list li,
.wallet-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}

.summary-list li:last-child,
.wallet-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.wallet-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.wallet-controls input {
  width: 110px;
  margin-bottom: 0;
  padding: 5px 8px;
  font-size: 13px;
}

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  text-align: left;
}

th {
  color: var(--muted);
  font-weight: 600;
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
}

td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border);
}

tr:last-child td {
  border-bottom: none;
}

td.amount,
td:last-child {
  color: var(--red);
  font-weight: 600;
}




/* ---------- PART H | SUMMARY BOXES AND PROGRESS BAR ----------
ASSIGN: lio
   PURPOSE: The 3 number cards, and the thin bar showing how
   much of the monthly budget is used (blue -> orange at 80%
   -> red when exceeded; JavaScript adds .warn / .danger). */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 16px;
}

.stat-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 16px 20px;
}

.stat-label {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 4px;
}

.stat-value {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
}

.progress-track {
  width: 100%;
  height: 8px;
  background: var(--track);
  border-radius: 999px;
  overflow: hidden;
  margin-top: 8px;
}

.progress-fill {
  height: 100%;
  width: 0%;
  background: var(--blue);
  border-radius: 999px;
  transition: width 0.25s ease, background-color 0.25s ease;
}

.progress-fill.warn {
  background: #f59e0b;
}

.progress-fill.danger {
  background: var(--red);
}



/* ---------- PART I | SMALLER SCREENS ----------
ASSIGN: mark
   PURPOSE: Tablet and phone layouts. */
@media (max-width: 820px) {
  .grid-2,
  .stat-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  h2 {
    padding-right: 0;
  }

  .btn-top {
    position: static;
    margin-bottom: 16px;
    display: inline-block;
  }
}

@media (max-width: 640px) {
  .app {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
    height: auto;
    position: static;
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .content {
    padding: 16px;
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }
}